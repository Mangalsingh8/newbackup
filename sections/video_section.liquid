<div class="section_video" id="">
  <div class="red">
    <div class="w-embed-youtubevideo">
      <iframe
        class="youtube_section"
        src="{{ settings.video_url | replace: 'watch?v=', 'embed/' }}"
        title="YouTube video player"
        frameborder="0"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        allowfullscreen
      ></iframe>
    </div>
    <div class="red1">
      <div class="hello">Hello Word this pen</div>
    </div>
  </div>
</div>

<style>
  .section_video{
    width:96%;
    margin:0 auto;
  }
  .red{
    width:100%;
    display:flex;
  }
  .red1{
    width:50%;
  }
  .w-embed-youtubevideo{
    width:50%;
  }
  iframe.youtube_section{
    width: 100%;
    height:350px;
  }
  @media only screen and (min-width: 768px) and (max-width: 1023px) {}

  @media only screen and (min-width: 320px) and (max-width: 767px) {
    .red{
      width:100%;
      display:block;
    }
  }
</style>

{% schema %}
{
    "name": "Embed Youtube",
    "settings": [
        {
            "id": "video_url",
            "type": "url",
            "label": "Video URL",
            "info": "Insert Youtube or Vimeo URL"
        }
    ],
    "presets": [
        {
            "name": "Hello"
        }
    ]
}
{% endschema %}
